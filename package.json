{
  "name": "create-dda-stack",
  "version": "0.6.2",
  "description": "Create a React Native superapp (host + mini-apps) with Re.Pack and Module Federation in one command. Also creates regular Expo and React Native CLI apps with navigation, React Query, Axios, env config and optional Zustand or Redux Toolkit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducdinh-codehub/dda-stack.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "create-react-native-app",
    "scaffold",
    "cli",
    "module-federation",
    "superapp",
    "super-app",
    "mini-app",
    "repack",
    "re-pack",
    "microfrontend",
    "zustand",
    "redux-toolkit"
  ],
  "bin": "dist/index.js",
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "dev": "tsx src/index.ts",
    "banner": "FORCE_COLOR=3 tsx scripts/generate-banner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "execa": "^9.5.2",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/validate-npm-package-name": "^4.0.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.26.0"
}
